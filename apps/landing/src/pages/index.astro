---
import Base from "../layouts/Base.astro";
import logoLight from "../assets/logo/logo-light.svg";
import logoDark from "../assets/logo/logo-dark.svg";
import iconLight from "../assets/logo/icon-light.svg";
import sit1 from "../assets/avatar/sit01.png";
import sit2 from "../assets/avatar/sit02.png";
import sit3 from "../assets/avatar/sit03.png";
import pgLight from "../assets/schools/pg-light.svg";
import pgDark from "../assets/schools/pg-dark.svg";

---

<Base title="Lektionsvy">
	<div class="min-h-screen relative overflow-hidden">

		<!-- Nav -->
		<nav class="relative z-10 flex items-center justify-between px-8 md:px-16 py-6 max-w-6xl mx-auto">
			<img src={logoLight.src} alt="Lektionsvy" class="h-8 dark:hidden" />
			<img src={logoDark.src} alt="Lektionsvy" class="h-8 hidden dark:block" />
			<div class="flex items-center gap-6">
				<button id="dark-toggle" class="w-9 h-9 rounded-lg border border-indigo-900/10 dark:border-indigo-300/15 flex items-center justify-center text-indigo-700 dark:text-indigo-300 hover:bg-indigo-100 dark:hover:bg-indigo-900/30 transition-colors cursor-pointer" aria-label="Byt tema">
					<svg class="w-4 h-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
					<svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
				</button>
				<a href="https://app.lektionsvy.se" class="text-sm font-medium text-indigo-600 dark:text-indigo-300 hover:text-indigo-700 dark:hover:text-indigo-200 transition-colors">
					Öppna appen &rarr;
				</a>
			</div>
		</nav>

		<!-- Hero -->
		<section class="relative z-10 max-w-6xl mx-auto px-8 md:px-16 pt-24 md:pt-40 pb-20">
			<div class="max-w-2xl">
				<h1 class="font-display text-4xl md:text-6xl font-600 leading-[1.08] tracking-tight text-indigo-900 dark:text-indigo-100">
					Widgetbaserad lektionsvy för svenska skolor
				</h1>
				<p class="mt-6 text-lg md:text-xl text-indigo-900/70 dark:text-indigo-200/60 max-w-md leading-relaxed">
					Visa klocka, timer och information på klassrumsskärmen. Dra, ändra storlek och komponera fritt med widgets.
				</p>
				<div class="mt-10 flex flex-wrap gap-4">
					<a href="https://app.lektionsvy.se" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm tracking-wide transition-colors shadow-[0_2px_16px_rgba(79,70,229,0.25)]">
						Öppna Lektionsvy
					</a>
					<a href="https://github.com/varohlen/lektionstavla" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-indigo-900/12 dark:border-indigo-300/12 text-indigo-700 dark:text-indigo-300 font-medium text-sm hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-colors">
						Källkod på GitHub
					</a>
				</div>
			</div>

		</section>

		<!-- School variants (compact, right under hero) -->
		<div class="relative z-10 max-w-6xl mx-auto px-8 md:px-16 pb-24">
			<div class="flex items-center gap-3 text-sm text-indigo-900/45 dark:text-indigo-200/35">
				<span>Även tillgänglig för:</span>
				<a href="https://partille.lektionsvy.se" class="inline-flex items-center gap-1.5 text-indigo-600/70 dark:text-indigo-400/60 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
					Partille Gymnasium
					<svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
				</a>
				<span class="text-indigo-900/20 dark:text-indigo-200/15">|</span>
				<a href="#skolvarianter" class="text-indigo-600/70 dark:text-indigo-400/60 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">Fler varianter &darr;</a>
			</div>
		</div>

		<!-- Divider -->
		<div class="max-w-6xl mx-auto px-8 md:px-16">
			<hr class="border-indigo-900/8 dark:border-indigo-300/8" />
		</div>

		<!-- Features -->
		<section class="relative z-10 max-w-6xl mx-auto px-8 md:px-16 py-24 md:py-32">
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-14">
				<div>
					<div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
					</div>
					<h3 class="font-display text-lg font-500 text-indigo-900 dark:text-indigo-100">Widgetbaserad</h3>
					<p class="mt-2 text-sm text-indigo-900/60 dark:text-indigo-200/50 leading-relaxed">Dra, ändra storlek och placera widgets fritt. Klockor, timers, text, QR-koder och mer.</p>
				</div>
				<div>
					<div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h3 class="font-display text-lg font-500 text-indigo-900 dark:text-indigo-100">Fungerar offline</h3>
					<p class="mt-2 text-sm text-indigo-900/60 dark:text-indigo-200/50 leading-relaxed">Inga konton, ingen inloggning. Allt körs direkt i webbläsaren.</p>
				</div>
				<div>
					<div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
					</div>
					<h3 class="font-display text-lg font-500 text-indigo-900 dark:text-indigo-100">Öppen källkod</h3>
					<p class="mt-2 text-sm text-indigo-900/60 dark:text-indigo-200/50 leading-relaxed">Fritt att använda, forka och anpassa. Byggt med SvelteKit.</p>
				</div>
				<div>
					<div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M9 8h6M9 12h6M9 16h6M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16"/></svg>
					</div>
					<h3 class="font-display text-lg font-500 text-indigo-900 dark:text-indigo-100">På svenska</h3>
					<p class="mt-2 text-sm text-indigo-900/60 dark:text-indigo-200/50 leading-relaxed">Byggt för svenska skolor från början. Hela gränssnittet på svenska.</p>
				</div>
				<div>
					<div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
					</div>
					<h3 class="font-display text-lg font-500 text-indigo-900 dark:text-indigo-100">Spara tavlor</h3>
					<p class="mt-2 text-sm text-indigo-900/60 dark:text-indigo-200/50 leading-relaxed">Spara och ladda tavlor lokalt. Byt snabbt mellan olika upplägg för olika lektioner.</p>
				</div>
				<div>
					<div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 10h2M10 10h2M14 10h2M18 10h2M8 14h8"/></svg>
					</div>
					<h3 class="font-display text-lg font-500 text-indigo-900 dark:text-indigo-100">Tangentbordsgenvägar</h3>
					<p class="mt-2 text-sm text-indigo-900/60 dark:text-indigo-200/50 leading-relaxed">Snabb åtkomst till alla funktioner direkt från tangentbordet.</p>
				</div>
			</div>
		</section>

		<!-- Divider -->
		<div class="max-w-6xl mx-auto px-8 md:px-16">
			<hr class="border-indigo-900/8 dark:border-indigo-300/8" />
		</div>

		<!-- Widgets -->
		<section class="relative z-10 max-w-6xl mx-auto px-8 md:px-16 py-24 md:py-32">
			<h2 class="font-display text-2xl md:text-3xl font-500 text-indigo-900 dark:text-indigo-100">Widgets</h2>
			<p class="mt-3 text-indigo-900/60 dark:text-indigo-200/50 max-w-lg">Placera fritt på skärmen. Ändra storlek efter behov.</p>

			<div class="mt-12 grid md:grid-cols-3 gap-10">
				<div>
					<h3 class="text-xs font-medium uppercase tracking-widest text-indigo-500 dark:text-indigo-400 mb-4">Tid</h3>
					<div class="flex flex-wrap gap-2">
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Digitalklocka</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Analog klocka</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">LCD-klocka</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Datum</span>
					</div>
				</div>
				<div>
					<h3 class="text-xs font-medium uppercase tracking-widest text-indigo-500 dark:text-indigo-400 mb-4">Timers</h3>
					<div class="flex flex-wrap gap-2">
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Digital timer</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Analog timer</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Stoppur</span>
					</div>
				</div>
				<div>
					<h3 class="text-xs font-medium uppercase tracking-widest text-indigo-500 dark:text-indigo-400 mb-4">Innehåll</h3>
					<div class="flex flex-wrap gap-2">
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Rubrik</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Brödtext</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">QR-kod</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Skollogotyp</span>
						<span class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-indigo-900/20 border border-indigo-900/6 dark:border-indigo-300/8 text-sm text-indigo-900 dark:text-indigo-100">Trelson</span>
					</div>
				</div>
			</div>

			<div class="mt-10">
				<a href="https://app.lektionsvy.se" class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors">
					Se alla widgets i appen &rarr;
				</a>
			</div>
		</section>

		<!-- Divider -->
		<div class="max-w-6xl mx-auto px-8 md:px-16">
			<hr class="border-indigo-900/8 dark:border-indigo-300/8" />
		</div>

		<!-- School variants -->
		<section id="skolvarianter" class="relative z-10 max-w-6xl mx-auto px-8 md:px-16 py-24">
			<h2 class="font-display text-2xl md:text-3xl font-500 text-indigo-900 dark:text-indigo-100">Skolvarianter</h2>
			<p class="mt-3 text-indigo-900/60 dark:text-indigo-200/50 max-w-lg">Lektionsvy kan anpassas med er skolas grafiska profil — färger, logotyp och typsnitt.</p>
			<div class="mt-8 flex flex-wrap items-center gap-4">
				<a href="https://partille.lektionsvy.se" class="inline-flex items-center gap-3 px-6 py-4 rounded-xl border border-indigo-900/10 dark:border-indigo-300/10 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-colors group">
					<img src={pgLight.src} alt="Partille Gymnasium" class="h-6 dark:hidden opacity-70 group-hover:opacity-100 transition-opacity" />
					<img src={pgDark.src} alt="Partille Gymnasium" class="h-6 hidden dark:block opacity-60 group-hover:opacity-100 transition-opacity" />
					<svg class="w-3.5 h-3.5 opacity-30 group-hover:opacity-60 transition-opacity text-indigo-700 dark:text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
				</a>
			</div>
			<p class="mt-8 text-sm text-indigo-900/45 dark:text-indigo-200/35">
				Vill du ha en variant för din skola eller kommun? <a href="mailto:v@arohlen.se" class="text-indigo-600/70 dark:text-indigo-400/60 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors underline underline-offset-2">Hör av dig</a>
			</p>
		</section>

		<!-- Footer -->
		<footer class="relative z-10 max-w-6xl mx-auto px-8 md:px-16 py-12 border-t border-indigo-900/8 dark:border-indigo-300/8">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
				<a href="https://arohlen.se" class="group flex items-center gap-3 text-xs text-indigo-900/45 dark:text-indigo-200/35 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
					Ett projekt av Viktor
					<div class="w-8 h-8 relative [image-rendering:pixelated]">
						<img src={sit1.src} alt="Viktor Arohlén" class="absolute inset-0 w-full h-full avatar-frame" data-frame="1" />
						<img src={sit2.src} alt="" class="absolute inset-0 w-full h-full avatar-frame opacity-0" data-frame="2" />
						<img src={sit3.src} alt="" class="absolute inset-0 w-full h-full avatar-frame opacity-0" data-frame="3" />
					</div>
				</a>
				<div class="flex items-center gap-4">
					<a href="mailto:v@arohlen.se" class="text-xs text-indigo-900/40 dark:text-indigo-200/30 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">Förslag eller frågor? v@arohlen.se</a>
					<a href="https://github.com/varohlen/lektionstavla" class="text-xs text-indigo-600/60 dark:text-indigo-400/50 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">GitHub</a>
				</div>
			</div>
		</footer>

	</div>
</Base>
