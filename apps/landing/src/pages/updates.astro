---
import Base from "../layouts/Base.astro";
import logoLight from "../assets/logo/logo-light.svg";
import logoDark from "../assets/logo/logo-dark.svg";
import { getCollection } from "astro:content";
import { render } from "astro:content";

const posts = (await getCollection("uppdateringar")).sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base title="Uppdateringar | Lektionstavla">
	<div class="min-h-screen relative overflow-hidden">

		<!-- Nav -->
		<nav class="relative z-10 flex items-center justify-between px-8 md:px-16 py-6 max-w-6xl mx-auto">
			<a href="/">
				<img src={logoLight.src} alt="Lektionstavla" class="h-10 dark:hidden" />
				<img src={logoDark.src} alt="Lektionstavla" class="h-10 hidden dark:block" />
			</a>
			<div class="flex items-center gap-6">
				<button id="dark-toggle" class="w-9 h-9 rounded-lg border border-indigo-900/10 dark:border-indigo-300/15 flex items-center justify-center text-indigo-700 dark:text-indigo-300 hover:bg-indigo-100 dark:hover:bg-indigo-900/30 transition-colors cursor-pointer" aria-label="Byt tema">
					<svg class="w-4 h-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
					<svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
				</button>
				<a href="https://app.lektionstavla.se" class="text-sm font-medium text-indigo-600 dark:text-indigo-300 hover:text-indigo-700 dark:hover:text-indigo-200 transition-colors">
					Öppna appen &rarr;
				</a>
			</div>
		</nav>

		<!-- Content -->
		<section class="relative z-10 max-w-3xl mx-auto px-8 md:px-16 pt-16 pb-24">
			<h1 class="font-display text-3xl md:text-4xl font-600 tracking-tight text-indigo-900 dark:text-indigo-100">
				Uppdateringar
			</h1>
			<p class="mt-3 text-indigo-900/60 dark:text-indigo-200/50">Senaste nytt om Lektionstavla.</p>

			<div class="mt-14 space-y-14">
				{posts.map(async (post) => {
					const { Content } = await render(post);
					return (
						<article class="relative pl-8 border-l-2 border-indigo-200 dark:border-indigo-800">
							<time class="text-sm font-medium text-indigo-500 dark:text-indigo-400">
								{new Date(post.data.date).toLocaleDateString("sv-SE", { year: "numeric", month: "long", day: "numeric" })}
							</time>
							<h2 class="mt-2 font-display text-xl font-500 text-indigo-900 dark:text-indigo-100">
								{post.data.title}
							</h2>
							<div class="mt-3 text-base text-indigo-900/70 dark:text-indigo-200/60 leading-relaxed [&_strong]:font-semibold [&_strong]:text-indigo-900 dark:[&_strong]:text-indigo-100 [&_p+p]:mt-3 [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_li]:pl-1">
								<Content />
							</div>
						</article>
					);
				})}
			</div>

			<p class="mt-16 text-sm text-indigo-900/45 dark:text-indigo-200/35">
				Mer information finns på <a href="https://arohlen.se/blog" class="text-indigo-600/70 dark:text-indigo-400/60 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors underline underline-offset-2">Viktors blogg</a>.
			</p>
		</section>

	</div>
</Base>
